{
	"compilerOptions": {
		"target": "ES2020",
		"jsx": "preserve",
		"lib": ["ES2020", "DOM"],
		"baseUrl": ".",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./*"]
		},
		"resolveJsonModule": true,
		"strict": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["env.d.ts", "types/**/*", "**/*", "**/*.vue"]
}

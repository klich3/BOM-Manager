{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "BOMManager",
	"version": "0.1.0",
	"identifier": "com.sychev.bommanager",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "BOM-Manager",
				"width": 1600,
				"height": 1200,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	},
	"plugins": {
		"sql": {
			"preload": ["sqlite:bom_manager.db"]
		}
	}
}
